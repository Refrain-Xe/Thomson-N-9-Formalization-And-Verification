/-- (i)-步2：M·Lᵀ = S（自 stepsq 逐项提取）。 -/
theorem step2_AA0 : MAA0 * LAA0ᵀ = SAA0 := by
  ext k l
  show MAA0 k ⬝ᵥ LAA0 l = SAA0 k l
  linarith [(entries_of_sumsq2 (fun k l => LAA0 k l * dAA0 l - MAA0 k l)
    (fun k l => MAA0 k ⬝ᵥ LAA0 l - SAA0 k l) stepsq_AA0 k l).2]

/-- (i) 重构合流：L·diag(D)·Lᵀ = S。 -/
theorem recon_AA0 : LAA0 * Matrix.diagonal dAA0 * LAA0ᵀ = SAA0 := by
  rw [step1_AA0, step2_AA0]

/-- σ_i(y) = v(y)ᵀ S v(y)。 -/
noncomputable def sigAA0 (y : ℝ) : ℝ :=
  (fun k : Fin 17 => y ^ (k : ℕ)) ⬝ᵥ (SAA0 *ᵥ (fun k : Fin 17 => y ^ (k : ℕ)))

/-- (ii) 平方和表示：σ_i(y) = Σ_j d_j·(Σ_k L[k][j]·y^k)²。 -/
theorem sigAA0_quad (y : ℝ) : sigAA0 y
    = ∑ j : Fin 17, dAA0 j * (∑ k : Fin 17, LAA0 k j * y ^ (k : ℕ)) ^ 2 :=
  quad_of_recon SAA0 MAA0 LAA0 dAA0 step1_AA0 step2_AA0 y

/-- 主元正性：d_j > 0 逐字面量。 -/
theorem dAA0_pos : ∀ j : Fin 17, 0 < dAA0 j := by
  intro j; fin_cases j <;> norm_num [dAA0]

