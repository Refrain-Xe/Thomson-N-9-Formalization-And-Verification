  show MAB1 k ⬝ᵥ LAB1 l = SAB1 k l
  linarith [(entries_of_sumsq2 (fun k l => LAB1 k l * dAB1 l - MAB1 k l)
    (fun k l => MAB1 k ⬝ᵥ LAB1 l - SAB1 k l) stepsq_AB1 k l).2]

/-- (i) 重构合流：L·diag(D)·Lᵀ = S。 -/
theorem recon_AB1 : LAB1 * Matrix.diagonal dAB1 * LAB1ᵀ = SAB1 := by
  rw [step1_AB1, step2_AB1]

/-- σ_i(y) = v(y)ᵀ S v(y)。 -/
noncomputable def sigAB1 (y : ℝ) : ℝ :=
  (fun k : Fin 17 => y ^ (k : ℕ)) ⬝ᵥ (SAB1 *ᵥ (fun k : Fin 17 => y ^ (k : ℕ)))

/-- (ii) 平方和表示：σ_i(y) = Σ_j d_j·(Σ_k L[k][j]·y^k)²。 -/
theorem sigAB1_quad (y : ℝ) : sigAB1 y
    = ∑ j : Fin 17, dAB1 j * (∑ k : Fin 17, LAB1 k j * y ^ (k : ℕ)) ^ 2 :=
  quad_of_recon SAB1 MAB1 LAB1 dAB1 step1_AB1 step2_AB1 y

/-- 主元正性：d_j > 0 逐字面量。 -/
theorem dAB1_pos : ∀ j : Fin 17, 0 < dAB1 j := by
  intro j; fin_cases j <;> norm_num [dAB1]

