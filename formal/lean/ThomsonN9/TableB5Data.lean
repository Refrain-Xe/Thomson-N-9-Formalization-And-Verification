/-- deltaMax > 0（适用域非空）。 -/
theorem deltaMax_pos : (0:ℚ) < deltaMax := by norm_num [deltaMax]
/-- sqrt 界前提①：u₁ ≤ s1Up²（⇒ √u₁ ≤ s1Up）。 -/
theorem s1Up_sq_ge_u1 : u1 ≤ s1Up^2 := by norm_num [s1Up, u1]
/-- sqrt 界前提②：s3Dn² ≤ l₃（⇒ s3Dn ≤ √l₃）。 -/
theorem s3Dn_sq_le_l3 : s3Dn^2 ≤ l3 := by norm_num [s3Dn, l3]
/-- sqrt 界前提③：72 ≤ sqrt72Up²（⇒ √72 ≤ sqrt72Up）。 -/
theorem sqrt72Up_sq_ge_72 : (72:ℚ) ≤ sqrt72Up^2 := by norm_num [sqrt72Up]
/-- sqrt 界前提④：s3Dn ≤ s1Up（⇒ s3Dn/(2·s1Up) ≤ 1/2，δ_max 适用的 min 支路）。 -/
theorem s3Dn_le_s1Up : s3Dn ≤ s1Up := by norm_num [s3Dn, s1Up]

/-- 装配①：C_inner = u₁·s1Up/l₃² + 2/s3Dn（636-bit norm_num，D56 探针②）。 -/
theorem C_inner_val : u1 * s1Up / (l3*l3) + 2/s3Dn = CInner := by
  norm_num [u1, s1Up, l3, s3Dn, CInner]
/-- 装配②：C = sqrt72Up·CInner。 -/
theorem C_val : sqrt72Up * CInner = CVal := by norm_num [sqrt72Up, CInner, CVal]
/-- 装配③：C_chord = 2·C（弦距离口径）。 -/
theorem C_chord_val : 2 * CVal = CChord := by norm_num [CVal, CChord]
/-- 装配④：δ_max = (s3Dn/(2·s1Up))·l₃²/(sqrt72Up·u₁)。 -/
theorem delta_max_val : (s3Dn/(2*s1Up)) * (l3*l3) / (sqrt72Up * u1) = deltaMax := by
  norm_num [s3Dn, s1Up, l3, sqrt72Up, u1, deltaMax]

