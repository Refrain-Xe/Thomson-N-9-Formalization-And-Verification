/-- TTP 族对角化二次型（ℚ 面）：vᵀXᵀXv 的对角公式。 -/
def diagQ (z v0 v1 v2 : ℚ) : ℚ := (3*(1-z^2)+3/2)*(v0^2+v1^2) + 6*z^2*v2^2

