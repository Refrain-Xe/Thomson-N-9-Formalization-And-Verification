    0 ≤ pAA y := by
  have hb : 0 ≤ (437/500) - y * y := sub_nonneg.2 hy2
  have q0 : 0 ≤ ∑ j : Fin 17, dAA0 j * (∑ k : Fin 17, LAA0 k j * y ^ (k : ℕ)) ^ 2 :=
    Finset.sum_nonneg fun j _ => mul_nonneg (le_of_lt (dAA0_pos j)) (sq_nonneg _)
  have q1 : 0 ≤ ∑ j : Fin 17, dAA1 j * (∑ k : Fin 17, LAA1 k j * y ^ (k : ℕ)) ^ 2 :=
    Finset.sum_nonneg fun j _ => mul_nonneg (le_of_lt (dAA1_pos j)) (sq_nonneg _)
  have q2 : 0 ≤ ∑ j : Fin 16, dAA2 j * (∑ k : Fin 16, LAA2 k j * y ^ (k : ℕ)) ^ 2 :=
    Finset.sum_nonneg fun j _ => mul_nonneg (le_of_lt (dAA2_pos j)) (sq_nonneg _)
  have q3 : 0 ≤ ∑ j : Fin 16, dAA3 j * (∑ k : Fin 16, LAA3 k j * y ^ (k : ℕ)) ^ 2 :=
    Finset.sum_nonneg fun j _ => mul_nonneg (le_of_lt (dAA3_pos j)) (sq_nonneg _)
