  sigAA0 y + y * sigAA1 y + ((437/500) - y * y) * sigAA2 y
    + y * ((437/500) - y * y) * sigAA3 y

theorem pAA_sos (y : ℝ) : pAA y
    = (∑ j : Fin 17, dAA0 j * (∑ k : Fin 17, LAA0 k j * y ^ (k : ℕ)) ^ 2)
    + y * (∑ j : Fin 17, dAA1 j * (∑ k : Fin 17, LAA1 k j * y ^ (k : ℕ)) ^ 2)
